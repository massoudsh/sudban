{
  "name": "sudban",
  "version": "0.1.0",
  "description": "سودبان — دستیار هوشمند تصمیم‌گیری قیمت و مدیریت حاشیه سود",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
