# --- دیتابیس (الزامی) ---
# اجرای مستقیم روی میزبان:
#   DATABASE_URL="postgresql://user:password@localhost:5432/sudban?schema=public"
# Docker Compose (نام میزبان سرویس دیتابیس، db است و رمز باید با POSTGRES_PASSWORD یکی باشد):
#   DATABASE_URL="postgresql://sudban:YOUR_PASSWORD@db:5432/sudban?schema=public"
DATABASE_URL=
PORT=3000

# --- Docker Compose (اختیاری؛ فقط برای docker compose up) ---
POSTGRES_USER=sudban
POSTGRES_PASSWORD=
POSTGRES_DB=sudban
# پورت میزبان برای API و برای دسترسی محلی به دیتابیس (فقط روی 127.0.0.1)
APP_PORT=3000
POSTGRES_PORT=5432

# CORS — لیست origin های مجاز مرورگر، جدا با کاما (خالی = فقط سرور-به-سرور)
CORS_ORIGINS=

# Rate limiting — حداکثر درخواست هر IP در هر پنجره (پیش‌فرض: ۳۰۰ درخواست / ۱۵ دقیقه = 900000ms)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=900000

# محدودیت اندازه بدنه درخواست (هر دو با فرمت express، مثل 1mb / 512kb)
JSON_BODY_LIMIT=1mb
BULK_IMPORT_BODY_LIMIT=2mb

# تایم‌اوت‌های سرور (میلی‌ثانیه): کل درخواست / دریافت هدرها / اتصال بیکار
# REQUEST_TIMEOUT_MS سخاوتمندانه است چون bulk-import می‌تواند طولانی شود؛ HEADERS_TIMEOUT_MS سخت‌گیرانه می‌ماند.
REQUEST_TIMEOUT_MS=120000
HEADERS_TIMEOUT_MS=15000
KEEP_ALIVE_TIMEOUT_MS=5000

# نسخه دمو — فقط برای محیط غیرعملیاتی true شود؛ یک فروشگاه OWNER نمونه ایجاد/بازیابی می‌شود.
DEMO_MODE=false

# کانال هشدار تلگرام (اختیاری)
TELEGRAM_BOT_TOKEN=

# کانال هشدار ایمیل — وب‌هوک عمومی POST { to, subject, text } (اختیاری)
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# کانال هشدار پیامک — وب‌هوک عمومی POST { to, text } (اختیاری)
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
