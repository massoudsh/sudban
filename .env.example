DATABASE_URL="postgresql://user:password@localhost:5432/sudban?schema=public"
PORT=3000

# CORS — لیست origin های مجاز مرورگر، جدا با کاما (خالی = فقط سرور-به-سرور)
CORS_ORIGINS=

# Rate limiting — حداکثر درخواست هر IP در هر ۱۵ دقیقه
RATE_LIMIT_MAX=300

# کانال هشدار تلگرام (اختیاری)
TELEGRAM_BOT_TOKEN=

# کانال هشدار ایمیل — وب‌هوک عمومی POST { to, subject, text } (اختیاری)
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# کانال هشدار پیامک — وب‌هوک عمومی POST { to, text } (اختیاری)
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
